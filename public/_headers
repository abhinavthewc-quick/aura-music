# Revalidate HTML so a release always points to its current asset hashes.
# Keep these rules separate from /assets/*: Pages joins matching values.
/
  Cache-Control: no-cache

/admin
  Cache-Control: no-cache

/rooms
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
