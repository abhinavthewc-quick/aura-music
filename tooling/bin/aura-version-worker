#!/usr/bin/env python3
"""Run the source in this checkout, including when this file is symlinked."""
import runpy
import sys
from pathlib import Path

source = Path(__file__).resolve().parents[1] / 'audio' / 'audio_version_worker.py'
sys.path.insert(0, str(source.parent))
runpy.run_path(str(source), run_name='__main__')
